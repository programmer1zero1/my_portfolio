{
  "name": "myportfolio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:responsive-window": "npm run build --prefix packages/expo-responsive-window",
    "build:web": "npx expo export --platform web",
    "electron": "electron electron/main.cjs",
    "electron:dev": "node electron/run-dev.cjs",
    "electron:preview": "npx expo export --platform web && cross-env ELECTRON_LOAD_STATIC=1 electron electron/main.cjs",
    "electron:pack": "npm run build:web && electron-builder --dir",
    "electron:dist": "npm run build:web && electron-builder"
  },
  "build": {
    "appId": "com.myportfolio.desktop",
    "productName": "MyPortfolio",
    "directories": {
      "output": "release"
    },
    "files": [
      "!app/**/*",
      "!**/.expo/**",
      "!**/release/**",
      "!**/web-build/**",
      "!**/.env",
      "!**/.env.*",
      "!**/.env.local"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "@programmer1zero1/expo-responsive-window": "file:packages/expo-responsive-window",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "dotenv": "^17.3.7",
    "express": "^4.21.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "~1.18.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  }
}
